# Copy to .env for personal local overrides (gitignored). Precedence:
# process env (CI secrets) > .env > config/env/<TEST_ENV>.env
TEST_ENV=local            # local | dev | staging | prod
# BASE_URL=https://www.saucedemo.com
# API_URL=https://restful-booker.herokuapp.com
# TEST_TIMEOUT_MS=30000
# EXPECT_TIMEOUT_MS=5000
# ACTION_TIMEOUT_MS=10000
# NAVIGATION_TIMEOUT_MS=30000
# FEATURE_FLAGS=flagA,flagB  # comma-separated
# WORKERS=4                  # CI only; default 2
# AUTH_TTL_MINUTES=30          # storageState/token freshness window
# ADMIN_UI_USERNAME=... ADMIN_UI_PASSWORD=... ADMIN_API_USERNAME=... ADMIN_API_PASSWORD=...
# USER_UI_USERNAME=...  USER_UI_PASSWORD=...  USER_API_USERNAME=...  USER_API_PASSWORD=...
# GITHUB_MCP_TOKEN=...        # read-only PAT for the `github` MCP server in .mcp.json (see docs/MCP.md); unset = that server fails to connect
# WORKER_ACCOUNTS=user1:pass1,user2:pass2   # one per parallel worker; also the hard cap on workers
