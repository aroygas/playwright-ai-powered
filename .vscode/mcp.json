{
  "inputs": [
    {
      "id": "github_mcp_token",
      "type": "promptString",
      "description": "GitHub token (read-only: repo contents, issues, PRs)",
      "password": true
    }
  ],
  "servers": {
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@0.0.83",
        "--browser",
        "chromium",
        "--test-id-attribute",
        "data-test"
      ]
    },
    "playwright-test": {
      "command": "npx",
      "args": ["playwright", "run-test-mcp-server"]
    },
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/readonly",
      "headers": { "Authorization": "Bearer ${input:github_mcp_token}" }
    },
    "filesystem": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem@2.0.1", "${workspaceFolder}"]
    }
  }
}
