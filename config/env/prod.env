# Non-secret defaults for TEST_ENV=prod. Secrets come from process env / CI secrets, never from this file.
BASE_URL=https://www.saucedemo.com
API_URL=https://restful-booker.herokuapp.com
TEST_TIMEOUT_MS=30000
EXPECT_TIMEOUT_MS=5000
ACTION_TIMEOUT_MS=10000
NAVIGATION_TIMEOUT_MS=30000
FEATURE_FLAGS=
AUTH_TTL_MINUTES=30
# Public demo-SUT credentials (not secrets). Real environments: override via process env / CI secrets.
ADMIN_UI_USERNAME=visual_user
ADMIN_UI_PASSWORD=secret_sauce
ADMIN_API_USERNAME=admin
ADMIN_API_PASSWORD=password123
USER_UI_USERNAME=standard_user
USER_UI_PASSWORD=secret_sauce
USER_API_USERNAME=admin
USER_API_PASSWORD=password123
# One account per parallel worker (user:pass,...) for parallel-unsafe flows.
WORKER_ACCOUNTS=standard_user:secret_sauce,problem_user:secret_sauce,performance_glitch_user:secret_sauce,error_user:secret_sauce,visual_user:secret_sauce
